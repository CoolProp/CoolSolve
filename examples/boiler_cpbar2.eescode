"VL051107
Répétition 7, exercice 3

3.	Supposez que, pour la chaudière de la question 2 (température de l'eau à l'entrée égale à 70°C), on fixe la température de consigne à 80°C. Déterminez la fraction de temps de fonctionnement du brûleur (régulé en tout-ou-rien) ainsi que le rendement moyen de la chaudière.

"

T_w_ex_set=80
T_w_ex_set=theta*T_w_ex_on+(1-theta)*T_w_ex_off


AU_1=75.29 
AU_2=11.64  "!! "
M_dot_a=0.02153 [-]
M_dot_f=0.001292 
M_dot_w=0.5972 

y_c=0.869 "fraction massique de C"
y_h=1-y_c
c_f=1800 "[J/kg.K]" "chaleur massique du fuel"
LHV=4.3E7 "[J/kg]"
{M_dot_f=0.0006} 
{f=0.06 "fuel air ratio" "!!"}
T_a_su=25 
T_f_su=25 
T_env=25 

T_w_su=70 "!!" "retour de l'eau vers chaudière"
{T_w_ex=90 "!!"}
{T_gas_ex=220 "!!"} "!!"
{M_dot_w=0.28 "[kg/s]"} "!!"
{eta=0.9 "!!"
Q_dot_u=50E3 "!!"} "!!"

"pour 1 kg de fuel, on a y_c kg de C et y_h de H
pour 1 kg de fuel on a y_c/12 kmol de C et y_h/1 kmol de H
pour 1 mole de C, on a y_h*12/y_c mole de C"

m=1
n=y_h*12/y_c

"température adiabatique de combustion"
M_dot_f*LHV+M_dot_a*cp_a*(T_a_su-T_ref)+M_dot_f*c_f*(T_f_su-T_ref)=M_dot_p*cp_p*(T_p_ad-T_ref)


M_dot_a=M_dot_f/f
T_ref=25
cp_a=CP(air,T=T_a_su)
//cp_p=cpbar(m,n,f,T_p_ad,T_ref){1300}
cp_p = 1300
M_dot_p=M_dot_a+M_dot_f

"échangeur gaz-eau"

T_gas_su=T_p_ad
C_dot_p=M_dot_p*cp_p_hex
//cp_p_hex=cpbar(m,n,f,T_gas_su,T_gas_ex){1300} "dans un premier temps"
cp_p_hex = 1300
C_dot_w=M_dot_w*cp_w
cp_w=4186
C_dot_min_1=MIN(C_dot_p,C_dot_w)
C_dot_max_1=MAX(C_dot_p,C_dot_w)
omega_1=C_dot_min_1/C_dot_max_1
epsilon_1=(1-exp(-NTU_1*(1-omega_1)))/(1-omega_1*exp(-NTU_1*(1-omega_1)))
NTU_1=AU_1/C_dot_min_1

Q_dot_1=epsilon_1*C_dot_min_1*(T_gas_su-T_w_su)
Q_dot_1=C_dot_w*(T_w_ex_1-T_w_su) "pour calculer T_w_ex_1"
Q_dot_1=C_dot_p*(T_gas_su-T_gas_ex) "calcul de la température de cheminée T_gas_ex"

"enveloppe: 2 en ON"
NTU_2=AU_2/C_dot_w
epsilon_2=1-exp(-NTU_2)
Q_dot_2_on=epsilon_2*C_dot_w*(T_w_ex_1-T_env)
Q_dot_2_on=C_dot_w*(T_w_ex_1-T_w_ex_on) "pour calculer T_w_ex"

Q_dot_u=Q_dot_1-Q_dot_2_on
Q_dot_c=M_dot_f*LHV
eta=Q_dot_u/Q_dot_c

"enveloppe:2 en OFF"

Q_dot_2_off=epsilon_2*C_dot_w*(T_w_su-T_env)
Q_dot_2_off=C_dot_w*(T_w_su-T_w_ex_off) 

"rendement moyen"
Q_dot_u_set=C_dot_w*(T_w_ex_set-T_w_su)
Q_dot_c_set=theta*Q_dot_c
eta_set=Q_dot_u_set/Q_dot_c_set

"
Variables in Main
AU_1=75.29 
AU_2=11.64 
cp_a=1007 [J/kg-K]
cp_p=1277 
cp_p_hex=1300 [-]
cp_w=4186 
C_dot_max_1=2500 [-]
C_dot_min_1=29.67 [-]
C_dot_p=29.67 [-]
C_dot_w=2500 [-]
c_f=1800 
epsilon_1=0.9194 [-]
epsilon_2=0.004644 [-]
eta=0.9 [-]
f=0.06 
LHV=4.300E+07 
m=1 
M_dot_a=0.02153 [-]
M_dot_f=0.001292 
M_dot_p=0.02283 [-]
M_dot_w=0.5972 
n=1.809 [-]
NTU_1=2.537 [-]
NTU_2=0.004655 [-]
omega_1=0.01187 [-]
Q_dot_1=50758 [-]
Q_dot_2=758.2 [-]
Q_dot_c=55556 [-]
Q_dot_u=50000 [-]
T_a_su=25 
T_env=25 
T_f_su=25 
T_gas_ex=220 
T_gas_su=1930 [-]
T_p_ad=1930 
