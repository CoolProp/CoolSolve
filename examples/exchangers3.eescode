"Shell-and-Tube Condenser for Steam Power Plant

A 1-2 shell-and-tube heat exchanger (1 shell pass, 2 tube passes) condenser for
a steam power plant. 30000 thin tubes, 25 mm outer diameter.
Convective heat transfer coefficient on steam side: 11000 W/(m2.K).
Exchanger capacity: 2000 MW. Water enters at 20 C (1 kg/s per tube), steam at 50 C.
Determine the water temperature rise and the tube length.
"


"given data"
D_ext=0.025 "[m]"
N_tubes=30000
h_vap=11000 "[W/m^2.K]"
Q_dot=2000E6 "[W]"
M_dot_1tube=1
T_w_su=20 
T_vap=50

"water outlet temperature"
{cp_w=4186}
cp_w=CP(Water,T=T_w_bar,P=100000)
Q_dot=N_tubes*M_dot_1tube*cp_w*(T_w_ex-T_w_su)

"efficiency"
Q_dot=epsilon*Q_dot_max
Q_dot_max=N_tubes*M_dot_1tube*cp_w*(T_vap-T_w_su)

"AU"
epsilon=1-exp(-NTU)
NTU=AU/C_dot_w
C_dot_w=N_tubes*M_dot_1tube*cp_w

"heat transfer coefficient evaluation — water side"
Re=vit*D_in/nu_w
D_in=D_ext "simplifying assumption: tube wall thickness neglected"
vit=V_dot_1tube/A_in
A_in=PI*D_in^2/4 "inner cross-section area"
V_dot_1tube=M_dot_1tube/rho_w
T_w_bar=0.5*(T_w_su+T_w_ex)
rho_w=density(water,T=T_w_bar,P=100000)
nu_w=mu_w/rho_w "kinematic viscosity [m^2/s]"
mu_w=VISCOSITY(Water,T=T_w_bar,P=100000) "dynamic viscosity [kg/(m.s)]"
j=0.023*Re^(-0.2)
j=St*Pr^(2/3)
St=Nu/(Re*Pr)
Pr=nu_w/alpha_w
alpha_w=k_w/(rho_w*cp_w) "thermal diffusivity [m^2/s]"
k_w=CONDUCTIVITY(Water,T=T_w_bar,P=100000) "water thermal conductivity [W/(m.K)]"
Nu=h_w*D_in/k_w

"overall heat transfer coefficient"
U=1/(1/h_w+1/h_vap) "hyp"

"total heat transfer area"
AU=A*U

"longueur d'un tube"
A=N_tubes*L_tube*PI*D_ext "surface area of a cylinder"
L_tube_bis=L_tube/2 "two water-side passes (see schematic)"

"water temperature rise"
DELTAT_w=T_w_ex-T_w_su
