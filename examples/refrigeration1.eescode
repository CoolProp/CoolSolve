"Basic Refrigeration Cycle (R134a)

A R134a refrigeration machine operating between:
  - Condensation temperature: 20 C
  - Evaporation temperature: -10 C
  - Subcooling at condenser outlet: 6 K
  - Superheat at evaporator outlet: 2 K
  - Isentropic efficiency of compressor: 0.75
  - Drive motor efficiency: 0.80

Required: determine mass flow rate, compressor power, and COP for 50 kW cooling capacity.
"
T_cond=20"[°C]"
T_ev=-10
DELTA_T_sc=6 "sub cooling"
DELTA_T_oh=2 "over heating"
epsilon_s_cp=0.75
eta_m=0.8

"mass flow rate"
 "point 1: compressor inlet:"
T_1=T_ev+DELTA_T_oh
P_1=P_ev
P_ev=pressure(R134a,T=T_ev,x=1) "saturation pressure at T_ev"
h_1=enthalpy(R134a,P=P_1,T=T_1)

	"point 2: compressor outlet = condenser inlet"
P_2=P_cd
P_cd=pressure(R134a,T=T_cond,x=1)
s_1=entropy(R134a,T=T_1,P=P_1)
h_2_s=enthalpy(R134a,P=P_2,s=s_1)
epsilon_s_cp=w_s/w
w_s=h_2_s-h_1 "[J/kg]"
w=h_2-h_1 "determines h_2"
T_2=temperature(R134a,P=P_2,h=h_2)

	"point 3: condenser outlet"
P_3=P_cd
T_3=T_cond-DELTA_T_sc
h_3=enthalpy(R134a,P=P_3,T=T_3)

	"point 4: evaporator inlet"
h_4=h_3 "isenthalpic expansion"
x_4=quality(R134a,P=P_4,h=h_4)
P_4=P_ev

"mass flow rate computation"
Q_dot_41=50E3 "[W]"
Q_dot_41=M_dot_r*w_41
w_41=h_1-h_4

"compressor power consumption"
W_dot_12=M_dot_r*w_12
w_12=h_2-h_1
W_dot_cp=W_dot_12/eta_m "electrical power consumption"

"COP"

COP=Q_dot_41/W_dot_cp

"cycle representation in the P-h diagram"
P[1]=P_1
h[1]=h_1

P[2]=P_2
h[2]=h_2

P[3]=P_3
h[3]=h_3

P[4]=P_4
h[4]=h_4

