"Heat Pump Cycle (R22)

A heat pump delivering 30 kW. Operating conditions:
  - Evaporation temperature: 8 C
  - Condensation temperature: 60 C, subcooling: 10 K
  - Refrigerant: R22

Heat source (evaporator): groundwater at 10 C. Evaporator effectiveness = 1.
Determine the COP, refrigerant mass flow rate, and groundwater flow rate extracted.
Compressor isentropic efficiency: 0.80.
"

T_cond=60 "!!""[°C]"
T_ev=8 "!!"
DELTA_T_sc=10 "!!" "sub cooling"
DELTA_T_oh=0 "!!" "over heating"
epsilon_s_cp=0.8 "!!"
{eta_m=0.8} "!!"

"mass flow rate"
 "point 1: compressor inlet:"
T_1=T_ev+DELTA_T_oh
P_1=P_ev
P_ev=pressure(R22,T=T_ev,x=1) "saturation pressure at T_ev"
h_1=enthalpy(R22,P=P_1,x=x_1) "!!"
x_1=1"!!"


	"point 2: compressor outlet = condenser inlet"
P_2=P_cd
P_cd=pressure(R22,T=T_cond,x=1)
s_1=entropy(R22,T=T_1,x=x_1) "!!"
h_2_s=enthalpy(R22,P=P_2,s=s_1)
epsilon_s_cp=w_s/w
w_s=h_2_s-h_1
w=h_2-h_1 "determines h_2"
T_2=temperature(R22,P=P_2,h=h_2)


	"point 3: condenser outlet"
P_3=P_cd
T_3=T_cond-DELTA_T_sc
h_3=enthalpy(R22,P=P_3,T=T_3)

	"point 4: evaporator inlet"
h_4=h_3 "isenthalpic expansion"
x_4=quality(R22,P=P_4,h=h_4)
P_4=P_ev


"mass flow rate computation" "looking at condenser side"
Q_dot_23=-30E3 "[W]" "!!"
Q_dot_23=M_dot_r*w_23
w_23=h_3-h_2


"compressor power consumption"
W_dot_12=M_dot_r*w_12
w_12=h_2-h_1
W_dot_cp=W_dot_12{/eta_m} "electrical power consumption"

"COP"

COP=-Q_dot_23/W_dot_cp "!!"

"groundwater flow rate extracted from the aquifer"
Q_dot_41=M_dot_r*(h_1-h_4) "evaporator thermal capacity"
Q_dot_41=M_dot_w*cp_w*(T_w_su-T_w_ex) "determines M_dot_w"
epsilon_ev=1
T_w_su=10
cp_w=4186
epsilon_ev=(T_w_su-T_w_ex)/(T_w_su-T_ev)
V_dot_w=M_dot_w/rho_w*3600 "[m^3/h]"
rho_w=1000

{
"representation of the cycle in the P-h diagram"
P[1]=P_1
h[1]=h_1

P[2]=P_2
h[2]=h_2

P[3]=P_3
h[3]=h_3

P[4]=P_4
h[4]=h_4

}
