"Crossflow Heat Exchanger — Hot Gas Heating Water

Hot gas (cp = 1000 J/(kg.K)) at 300 C is used to heat water at 35 C and 2 bar
in a crossflow heat exchanger. Water flow rate: 1 kg/s. Gas and water leave the
exchanger at 100 C and 125 C respectively. Convective heat transfer coefficient
on the gas side: 100 W/(m2.K).
Determine the heat exchanger area. (No pressure drops assumed.)
"

c_gaz=1000 "[J/kg.K]"
T_gaz_su=300
T_w_su=35
P_w=2E5 "[Pa]"
M_dot_w=1 "[kg/s]"
T_gaz_ex=100
T_w_ex=125
h_gaz=100 "[W/m^2.K]"

"energy balances"
Q_dot=M_dot_gaz*c_gaz*(T_gaz_su-T_gaz_ex)
Q_dot=M_dot_w*c_w*(T_w_ex-T_w_su)

"capacity flow rates"
C_dot_w=M_dot_w*c_w
c_w=CP(water,P=P_w,T=T_w_bar) "using mean inlet/outlet temperature"
T_w_bar=0.5*(T_w_su+T_w_ex)
C_dot_gaz=M_dot_gaz*c_gaz
C_dot_min=min(C_dot_w,C_dot_gaz)
C_dot_max=max(C_dot_w,C_dot_gaz)
omega=C_dot_min/C_dot_max


"effectiveness for computing NTU"
epsilon=1-exp((1/omega)*NTU^0.22*(exp(-omega*NTU^0.78)-1))
Q_dot=epsilon*C_dot_min*(T_gaz_su-T_w_su)

"AU computation"
NTU=AU/C_dot_min

"alternative AU computation"
Q_dot=AU_bis*DELTAT_LM "IX.24"
{AU=A*U}
DELTAT_0=T_gaz_su-T_w_su
DELTAT_L=T_w_ex-T_gaz_ex "??" ">0"
DELTAT_LM=(DELTAT_0-DELTAT_L)/(ln(DELTAT_0/DELTAT_L))

"wall temperature"
Q_dot=A*h_gaz*(T_gaz_bar-T_wall)
T_gaz_bar=0.5*(T_gaz_su+T_gaz_ex)
Q_dot=A*h_w*(T_wall-T_w_bar)
Q_dot=A*U*(T_gaz_bar-T_w_bar)
1/U=1/h_gaz+1/h_w

