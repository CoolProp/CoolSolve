"MSTh - SB - R5 - Exercice 2"

T_cd=50
T_ev=3
DELTAT_sc=4
DELTAT_oh=5

P_atm=1E5
P_a_su=P_atm
T_a_su=35
RH_su=0.5
T_a_ex=10
RH_ex=0.95

Q_dot_ev=25000

"Paramètres déterminés:"
"AU_f=1900 
M_dot_a=0.4761 
M_dot_r=0.1815" 

"!Frigo"

P_ev=PRESSURE(R134a,T=T_ev,x=0.5)
P_cd=PRESSURE(R134a,T=T_cd,x=0.5)

Q_dot_ev=M_dot_r*(h_1-h_4)
h_1=ENTHALPY(R134a,T=T_ev+DELTAT_oh,x=1)
h_4=h_3
h_3=ENTHALPY(R134a,T=T_cd-DELTAT_sc,x=0)

"!Côté air"

"!Régime HUMIDE"

Q_dot_ev=M_dot_a*(h_a_su-h_a_ex)-M_dot_cd*cp_w*T_cd_w

h_a_su=ENTHALPY(AirH2O,T=T_a_su,P=P_a_su,R=RH_su)
h_a_ex=ENTHALPY(AirH2O,T=T_a_ex,P=P_a_su,w=w_ex)

M_dot_cd=M_dot_a*(w_su-w_ex)
"RH_ex=RELHUM(AirH2O,T=T_a_ex,P=P_a_su,w=w_ex)"
w_ex=HUMRAT(AirH2O,T=T_a_ex,P=P_a_su,R=RH_ex)
"ou"
w_su=HUMRAT(AirH2O,T=T_a_su,P=P_a_su,R=RH_su)
cp_w=4187
T_cd_w=T_a_ex

Q_dot_ev=C_dot_a_f*(T_wb_su-T_wb_ex)
C_dot_a_f=M_dot_a*cp_a_f
T_wb_su=WETBULB(AirH2O,T=T_a_su,P=P_a_su,R=RH_su)
T_wb_ex=WETBULB(AirH2O,T=T_a_ex,P=P_a_su,w=w_ex)

"performances:"
Q_dot_ev=epsilon_ev_f*C_dot_min*(T_wb_su-T_ev)
C_dot_min=C_dot_a_f
epsilon_ev_f=1-exp(-NTU_f)
NTU_f=AU_f/C_dot_a_f

"!Problème:"
"l'exercice ne tourne que dans un sens, grosse instabilité numérique au niveau du calcul du RH_ex"

