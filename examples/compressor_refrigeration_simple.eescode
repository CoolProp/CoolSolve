"Refrigeration Compressor — Fluid Comparison (R22, R134a, Propane)

A reciprocating refrigeration compressor with the following characteristics:
  - Constant electromechanical losses: 3400 W
  - Loss factor: alpha = 0.30
  - Swept volumetric flow rate: 0.040 m3/s
  - Clearance factor: 6%

Determine the refrigerating capacity, power consumption and COP for this compressor
when operated with R22, R134a and propane under the following conditions:
  - Evaporation temperature: 0 C
  - Condensation temperature: 40 C
  - Subcooling at condenser outlet: 5 K
  - Superheat at evaporator outlet: 8 K
"

W_dot_loss_0=3400
alpha=0.3
V_dot_s=0.04
C=0.06

fluid$='R22'
fluid2$='R134a'

"First operating point (R22)" 
T_cd_1=40
T_ev_1=0
{Q_dot_ev_1=64E3
W_dot_1=16E3}

"Second operating point (R134a)"
T_cd_2=T_cd_1
T_ev_2=T_ev_1
{Q_dot_ev_2=70E3
W_dot_2=20E3}

DELTAT_sc=5
DELTAT_oh=8

"First operating point (R22) — equations"
T_su_1=T_ev_1+DELTAT_oh
P_su_1=P_ev_1
P_ev_1=pressure(fluid$,x=0.5,T=T_ev_1)
P_ex_1=P_cd_1
P_cd_1=pressure(fluid$,x=0.5,T=T_cd_1)
epsilon_v_1=1-C*(rv_1-1)
rv_1=v_su_1/v_ex_1
v_su_1=volume(fluid$,T=T_su_1,P=P_su_1)
s_su_1=entropy(fluid$,T=T_su_1,P=P_su_1)
v_ex_1=volume(fluid$,s=s_su_1,P=P_ex_1)
M_dot_1=V_dot_s*epsilon_v_1/v_su_1
h_su_1=enthalpy(fluid$,T=T_su_1,P=P_su_1)
h_ex_1_s=enthalpy(fluid$,s=s_su_1,P=P_ex_1)
w_s_1=h_ex_1_s-h_su_1 "[J/kg]"
W_dot_s_1=M_dot_1*w_s_1
W_dot_1=W_dot_loss_0+(1+alpha)*W_dot_s_1
Q_dot_ev_1=M_dot_1*(h_su_1-h_su_ev_1)
h_su_ev_1=h_ex_cd_1 "isenthalpic expansion"
h_ex_cd_1=enthalpy(fluid$,T=T_ex_cd_1,P=P_cd_1)
T_ex_cd_1=T_cd_1-DELTAT_sc

COP_1=Q_dot_ev_1/W_dot_1

"Second operating point (R134a) — equations"
T_su_2=T_ev_2+DELTAT_oh
P_su_2=P_ev_2
P_ev_2=pressure(fluid2$,x=0.5,T=T_ev_2)
P_ex_2=P_cd_2
P_cd_2=pressure(fluid2$,x=0.5,T=T_cd_2)
epsilon_v_2=1-C*(rv_2-1)
rv_2=v_su_2/v_ex_2
v_su_2=volume(fluid2$,T=T_su_2,P=P_su_2)
s_su_2=entropy(fluid2$,T=T_su_2,P=P_su_2)
v_ex_2=volume(fluid2$,s=s_su_2,P=P_ex_2)
M_dot_2=V_dot_s*epsilon_v_2/v_su_2
h_su_2=enthalpy(fluid2$,T=T_su_2,P=P_su_2)
h_ex_2_s=enthalpy(fluid2$,s=s_su_2,P=P_ex_2)
w_s_2=h_ex_2_s-h_su_2 "[J/kg]"
W_dot_s_2=M_dot_2*w_s_2
W_dot_2=W_dot_loss_0+(1+alpha)*W_dot_s_2
Q_dot_ev_2=M_dot_2*(h_su_2-h_su_ev_2)
h_su_ev_2=h_ex_cd_2 "isenthalpic expansion"
h_ex_cd_2=enthalpy(fluid2$,T=T_ex_cd_2,P=P_cd_2)
T_ex_cd_2=T_cd_2-DELTAT_sc

COP_2=Q_dot_ev_2/W_dot_2







