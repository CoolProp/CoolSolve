"Air Handling Unit — Moist Air Conditioning

Supply air for a room comes from outdoors. Outdoor air: T = 30 C, RH = 60%.
The supply conditions are achieved via an air handling unit.
Calculate: the cooling coil capacity (contact effectiveness = 80%), the post-heating
power, and the condensate flow rate at the cooling coil.
"

P_in=1E5
T_in=25
RH_in=0.5
M_dot_w=0.08/3600 "[kg/s]"
V_dot_a=40/3600 "[m^3/s]"
Q_dot_t=130 "[W]"

"supply air conditions"
Q_dot_t=M_dot_a*(h_in-h_su)
h_in=ENTHALPY(AirH2O,T=T_in,P=P_in,R=RH_in)
M_dot_a=V_dot_a/v_a_su

v_a_su=volume(airH2O,T=T_su{in},P=P_in,w=w_su{in}) "for updating initial guesses"
T_su=temperature(airH2O,h=h_su,P=P_in,w=w_su)

"water mass balance"
M_dot_a*w_su+M_dot_w=M_dot_a*w_in
w_in=humrat(airH2O,T=T_in,P=P_in,R=RH_in)

RH_su=Relhum(AIRH2O,P=P_in,T=T_su,w=w_su)

"outdoor conditions"

T_out=30
RH_out=0.60
	"cooling coil"
epsilon_c=0.8
epsilon_c=(w_out-w_su)/(w_out-w_c) "pour calculer w_c"
w_out=humrat(airH2O,T=T_out,R=RH_out,P=P_in)
T_c=dewpoint(airH2O,P=P_in,w=w_c,T=T_out)
epsilon_c=(T_out-T_ex_bat)/(T_out-T_c)

	"post-heating"
Q_dot_pc=M_dot_a*(h_su-h_ex_bat)
h_ex_bat=enthalpy(airH2O,P=P_in,T=T_ex_bat,w=w_su)
 "ou"
Q_dot_pc_bis=M_dot_a*(h_su_air-h_ex_bat_air)
h_su_air=enthalpy(air,T=T_su)
h_ex_bat_air=enthalpy(air,T=T_ex_bat)
	
	"condensate flow rate"
M_dot_w_cond=M_dot_a*(w_out-w_su)

	"cooling coil capacity"
h_out=enthalpy(airH2O,P=P_in,T=T_out,w=w_out)
Q_dot_batt=M_dot_a*(h_out-h_ex_bat)

"Q_dot_pc=Q_dot_pc_bis since no latent heat exchange after the cooling coil (humidity is constant = w_su)"

"digramme"
T[1]=T_out
w[1]=w_out
T[2]=T_ex_bat
w[2]=w_su
T[3]=T_su
w[3]=w_su
T[4]=T_in
w[4]=w_in
