"ORC with Two-Stage Expander and Extraction (R134a)

Organic Rankine Cycle model with a two-stage expander and intermediate
pressure extraction. Working fluid: R134a.
Evaporation temperature: 90 C, condensation temperature: 30 C.

SOLVER NOTE: Some solver configurations fail without the .initials file.
The default full pipeline converges successfully with initials provided.
"
T_ev=90

T_cd=30

fluid$='R134a'

P_ev=Pressure(fluid$,T=T_ev,x=0.5)

P_cd=Pressure(fluid$,T=T_cd,x=0.5)

"P_int_star=0.75"

P_int_star=P_int/sqrt(P_ev*P_cd)

P_int=P_f_in2_exp*0.9



T_int=temperature(fluid$,P=P_int,x=0.5)



"!1. EXPANDER"

"1.0 Parameter"

"V_s_exp=100e-6 [cm^3]"

W_dot_exp=5000

N=3000

DELTAT_f_su_exp=5

r_v_in=3

r_v_in_2=1.2

r_v_in_1=r_v_in/r_v_in_2



"1.1. Connections"

P_f_su_exp=P_ev

P_f_ex_exp=P_cd



"1.2. Supply status"

T_f_su_exp=T_ev+DELTAT_f_su_exp

v_f_su_exp=volume(fluid$,P=P_f_su_exp,T=T_f_su_exp)

h_f_su_exp=enthalpy(fluid$,P=P_f_su_exp,T=T_f_su_exp)

s_f_su_exp=entropy(fluid$,P=P_f_su_exp,T=T_f_su_exp)



"1.3. Supply pressure drop: su=>su1"

P_f_su1_exp=P_f_su_exp

T_f_su1_exp=T_f_su_exp

v_f_su1_exp=volume(fluid$,P=P_f_su1_exp,T=T_f_su1_exp)

h_f_su1_exp=enthalpy(fluid$,P=P_f_su1_exp,T=T_f_su1_exp)

s_f_su1_exp=entropy(fluid$,P=P_f_su1_exp,T=T_f_su1_exp)



"1.4. Displaced mass flow"

V_dot_s_exp=N/60*V_s_exp

M_dot_f_in_exp=V_dot_s_exp/v_f_su1_exp

M_dot_f_ev=M_dot_f_in_exp



"1.4. First expansion: su=>in1"

v_f_in1_exp=r_v_in_1*v_f_su1_exp

p_f_in1_exp=pressure(fluid$,v=v_f_in1_exp,s=s_f_su1_exp)

h_f_in1_exp=enthalpy(fluid$,v=v_f_in1_exp,s=s_f_su1_exp)

u_f_in1_exp=intenergy(fluid$,v=v_f_in1_exp,s=s_f_su1_exp)

h_f_in1_bis_exp=u_f_in1_exp+P_f_in1_exp*v_f_in1_exp

w_in_1_exp=h_f_su1_exp-h_f_in1_exp



"1.5. Extration: in1=>in2"

M_dot_f_ext=x_ext*M_dot_f_ev "extraction"

M_dot_f_cd="(1-x_ext)*"M_dot_f_ev

M_dot_f_in_exp*u_f_in1_exp-M_dot_f_ext*h_f_in1_exp=(M_dot_f_in_exp-M_dot_f_ext)*u_f_in2_exp

v_f_in2_exp=r_v_in_1*V_dot_s_exp/(M_dot_f_in_exp-M_dot_f_ext)

p_f_in2_exp=pressure(fluid$,v=v_f_in2_exp,u=u_f_in2_exp)



"h_f_in2_exp=u_f_in2_exp+P_f_in2_exp*v_f_in2_exp"

h_f_in2_exp=enthalpy(fluid$,v=v_f_in2_exp,u=u_f_in2_exp)"h_f_in1_exp"

s_f_in2_exp=entropy(fluid$,v=v_f_in2_exp,h=h_f_in2_exp)

w_in_2_exp=v_f_in1_exp*(P_f_in1_exp-P_f_in2_exp)







"1.6; Second expansion: in2=>in3"

v_f_in3_exp=r_v_in_2*v_f_in2_exp

h_f_in3_exp=enthalpy(fluid$,s=s_f_in2_exp,v=v_f_in3_exp)

P_f_in3_exp=pressure(fluid$,s=s_f_in2_exp,v=v_f_in3_exp)

w_in_3_exp=h_f_in2_exp-h_f_in3_exp



"1.7 Constant colume expansion: in3=>ex"

w_in_4_exp=v_f_in3_exp*(P_f_in3_exp-P_f_ex_exp)



"1.8 Expansion power"

W_dot_in_exp=M_dot_f_in_exp*(w_in_1_exp+w_in_2_exp)+(M_dot_f_in_exp-M_dot_f_ext)*(w_in_3_exp+w_in_4_exp)

W_dot_exp=W_dot_in_exp



"1.9. Exhaust state"

"M_dot_f_ev=1"

"x_ext=0.2"

h_f_ex_exp=h_f_in3_exp-w_in_4_exp

T_f_ex_exp=temperature(fluid$,P=P_f_ex_exp,s=s_f_su_exp)

s_f_ex_exp=s_f_su_exp



"1.10 Overall isentropic efficiency"

epsilon_s_exp=W_dot_exp/(M_dot_f_ev*(h_f_su_exp-h_f_ex_exp_s))

h_f_ex_exp_s=enthalpy(fluid$,P=P_f_ex_exp,s=s_f_su_exp)





"!2. MIXING"

M_dot_f_ev*h_f_su_cd=(M_dot_f_ev-M_dot_f_ext)*h_f_ex_exp+M_dot_f_ext*h_f_ex_hex_h





"!3. CONDENSER"

"3.0 Parameters"

DELTAT_f_ex_cd=5



"3.1. Inputs and connections"

"h_f_su_cd=h_f_ex_exp"



"3.2.vapor pzone "

x_f_su_cd=quality(fluid$,P=P_cd,h=h_f_su_cd)

T_f_su_cd=temperature(fluid$,P=P_cd,h=h_f_su_cd)

s_f_su_cd=entropy(fluid$,P=P_cd,h=h_f_su_cd)



"3.3. Two-phase"

h_f_su_cd_tp=min(h_f_su_cd,enthalpy(fluid$,P=P_cd,x=1))

h_f_ex_cd_tp=min(h_f_su_cd,enthalpy(fluid$,P=P_cd,x=0))

s_f_su_cd_tp=min(s_f_su_cd,entropy(fluid$,P=P_cd,x=1))

s_f_ex_cd_tp=min(s_f_su_cd,entropy(fluid$,P=P_cd,x=0))



"3.4. Liquid zone"

h_f_ex_cd=enthalpy(fluid$,P=P_cd,T=T_f_ex_cd)

s_f_ex_cd=entropy(fluid$,P=P_cd,T=T_f_ex_cd)

T_f_ex_cd=T_cd-DELTAT_f_ex_cd



"3.5. Total power"

Q_dot_cd=M_dot_f_cd*(h_f_su_cd-h_f_ex_cd)





"!4. PUMP"

"4.0. Parameters"

epsilon_s_pp=0.5



"4.1. Connections"

h_f_su_pp=h_f_ex_cd



"4.1. Supply"

T_f_su_pp=temperature(fluid$,P=P_cd,h=h_f_su_pp)

s_f_su_pp=entropy(fluid$,P=P_cd,h=h_f_su_pp)

x_f_su_pp=quality(fluid$,P=P_cd,h=h_f_su_pp)



"4.2 Compression power"

h_f_ex_pp_s=enthalpy(fluid$,P=P_ev,s=s_f_su_pp)

w_pp_s=h_f_ex_pp_s-h_f_su_pp

epsilon_s_pp=w_pp_s/w_pp

w_pp=h_f_ex_pp-h_f_su_pp

W_dot_pp=M_dot_f_ev*w_pp



"4.3. Exhaust conditions"

T_f_ex_pp=temperature(fluid$,P=P_ev,h=h_f_ex_pp)

s_f_ex_pp=entropy(fluid$,P=P_ev,h=h_f_ex_pp)

x_f_ex_pp=quality(fluid$,P=P_ev,h=h_f_ex_pp)



"!5. INTERNAL HEAT EXCHANGER"

"5.1. Parameters"

epsilon_hex=0.9

DELTAT_ex_hex_h=5

"x_ext=0.01"



"5.2. Connections"

T_f_su_hex=T_f_ex_pp



"5.3. State of the extracted vapour"

h_f_int_exp=h_f_in1_exp

T_f_int_exp=temperature(fluid$,P=P_int,h=h_f_in1_exp)

x_f_int_exp=quality(fluid$,P=P_int,h=h_f_in1_exp) "ok vapor"

s_f_int_exp=s_f_su_exp





"5.3. Thermal power"

Q_dot_hex=epsilon_hex*C_dot_f_hex*(T_int-T_f_su_hex)"0"

C_dot_f_hex=M_dot_f_ev*c_f_ex_pp

c_f_ex_pp=CP(fluid$,P=P_ev,T=T_f_ex_pp)



"5.4. Heat balance on the hot side"

Q_dot_hex=M_dot_f_ext*(h_f_int_exp-h_f_ex_hex_h)

h_f_ex_hex_h=enthalpy(fluid$,P=P_int,T=T_f_ex_hex_h)

T_f_ex_hex_h=T_int-DELTAT_ex_hex_h



"5.5. Heat balance on the cold side"

Q_dot_hex=M_dot_f_ev*(h_f_ex_hex-h_f_ex_pp)

T_f_ex_hex=temperature(fluid$,P=P_ev,h=h_f_ex_hex)



"!6. BOILER"

"6.1. Inputs and connections"

h_f_su_ev=h_f_ex_hex

T_f_su_ev=T_f_ex_hex



"6.2. liquid zone"

s_f_su_ev=entropy(fluid$,P=P_ev,h=h_f_su_ev)



h_f_su_ev_tp=enthalpy(fluid$,P=P_ev,x=0)

s_f_su_ev_tp=entropy(fluid$,P=P_ev,x=0)



"6.3. two-phase zone"

h_f_ex_ev_tp=enthalpy(fluid$,P=P_ev,x=1)

s_f_ex_ev_tp=entropy(fluid$,P=P_ev,x=1)



"6.4; vapor zone"

h_f_ex_ev=h_f_su_exp

s_f_ex_ev=s_f_su_exp





"total"

Q_dot_ev=M_dot_f_ev*(h_f_su_exp-h_f_su_ev)



"7. Global performance"

res=Q_dot_ev-W_dot_exp-Q_dot_cd+W_dot_pp

eta=(W_dot_exp-W_dot_pp)/Q_dot_ev





"8. T-s diagram"

"expander inlet"

T[1]=T_f_su_exp

s[1]=s_f_su_exp



"expander outlet / discharge"

T[2]=T_f_int_exp

s[2]=s_f_int_exp



"sortie expanseur"

T[3]=T_f_ex_exp

s[3]=s_f_ex_exp



"condenser inlet"

T[4]=T_f_su_cd

s[4]=s_f_su_cd





T[5]=T_cd

s[5]=s_f_su_cd_tp



T[6]=T_cd

s[6]=s_f_ex_cd_tp



T[7]=T_f_ex_cd

s[7]=s_f_ex_cd



T[8]=T_f_su_pp

s[8]=s_f_su_pp



T[9]=T_f_ex_pp

s[9]=s_f_ex_pp



T[10]=T_f_su_ev

s[10]=s_f_su_ev



T[11]=T_ev

s[11]=s_f_su_ev_tp



T[12]=T_ev

s[12]=s_f_ex_ev_tp



T[13]=T_f_su_exp

s[13]=s_f_su_exp


