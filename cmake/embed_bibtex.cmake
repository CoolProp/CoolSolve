# embed_bibtex.cmake
# Generates a C++ source file that embeds CoolProp's bibliography (CoolPropBibTeXLibrary.bib of the CoolProp
# sources) in the binary: the references of the equation of state on the badge of a chart
# (src/diagram/references.cpp, docs/coolplot_integration.md phase 4).
#
# Usage (a custom command of CMakeLists.txt, run again when the bibliography changes):
#   cmake -DINPUT=<CoolPropBibTeXLibrary.bib> -DOUTPUT_CPP=<path> -P embed_bibtex.cmake
#
# Without the file (a system CoolProp, built without its sources) the bibliography is empty: every reference then
# reads as its BibTeX key, as CoolPlot writes it when the bibliography is missing.

if(NOT OUTPUT_CPP)
    message(FATAL_ERROR "embed_bibtex.cmake requires OUTPUT_CPP")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/embed_common.cmake")

if(INPUT AND EXISTS "${INPUT}")
    coolsolve_file_as_hex_array("${INPUT}" BIB_HEX BIB_SIZE)
    get_filename_component(BIB_NAME "${INPUT}" NAME)
else()
    set(BIB_HEX "0x00")
    set(BIB_SIZE 0)
    set(BIB_NAME "no bibliography")
endif()

file(WRITE "${OUTPUT_CPP}"
    "// Generated by cmake/embed_bibtex.cmake from ${BIB_NAME}: do not edit.\n"
    "#include <cstddef>\n\n"
    "namespace coolsolve {\nnamespace diagram {\n\n"
    "extern const unsigned char COOLPROP_BIBTEX[] = {${BIB_HEX}};\n"
    "extern const std::size_t COOLPROP_BIBTEX_SIZE = ${BIB_SIZE};\n\n"
    "}  // namespace diagram\n}  // namespace coolsolve\n")
